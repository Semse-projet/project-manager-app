{
  "apiVersion": "semse.io/v1alpha1",
  "kind": "CapabilityDefinition",
  "metadata": {
    "name": "unsafe-ai-runtime",
    "version": "1.0.0",
    "publisher": "untrusted-publisher"
  },
  "spec": {
    "domain": "ai",
    "description": "Manifest inválido con un secreto literal",
    "dependencies": {
      "required": [],
      "optional": []
    },
    "interfaces": {
      "mcpTools": []
    },
    "permissions": ["ai:invoke"],
    "dataClassification": "restricted",
    "runtime": {
      "profile": "local-ai",
      "adapterKinds": ["compose"],
      "image": "ollama/ollama@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    },
    "configuration": {
      "secrets": {
        "MODEL_TOKEN": "sk-literal-must-never-be-accepted"
      }
    },
    "health": {
      "livenessPath": "/api/version",
      "readinessPath": "/api/tags"
    },
    "rollout": {
      "strategy": "canary",
      "rollbackRequired": true
    }
  }
}
