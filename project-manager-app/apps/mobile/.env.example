# ── API connection ────────────────────────────────────────────────────────────
# Must be reachable from the device/simulator, NOT `localhost` on a physical
# phone — use your machine's LAN IP (e.g. http://192.168.1.20:4132) or a
# tunneled URL when testing outside a simulator.
EXPO_PUBLIC_SEMSE_API_BASE_URL=http://localhost:4132

# ── Stripe (worker payout method) ───────────────────────────────────────────
# Same PUBLISHABLE key as apps/web's NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (safe
# to ship in the app bundle — it can only create tokens, never move money or
# read account data). Get it from the Stripe dashboard, same account as the
# server-side STRIPE_SECRET_KEY configured on apps/api. Without this set, the
# payout method screen shows a "not configured" message instead of collecting
# card/bank data insecurely. See AUDIT_REMEDIATION_PLAN.md 2.44.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
