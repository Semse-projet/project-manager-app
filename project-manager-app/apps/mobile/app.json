{
  "expo": {
    "name": "SEMSE",
    "slug": "semse-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "semse-mobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.semse.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.semse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SEMSE usa tu ubicación para avisarte cuando llegas a un job o proyecto y ofrecerte iniciar el reloj automáticamente, incluso con la app en segundo plano.",
          "locationWhenInUsePermission": "SEMSE usa tu ubicación para avisarte cuando llegas a un job o proyecto y ofrecerte iniciar el reloj.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SEMSE usa tu galería para adjuntar fotos como evidencia de trabajo.",
          "cameraPermission": "SEMSE usa tu cámara para tomar fotos como evidencia de trabajo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#3b82f6"
        }
      ],
      "expo-notifications",
      "expo-task-manager",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "718f27b3-c5b9-4f5c-a695-94fd3f85a5c7"
      }
    },
    "owner": "semseproject.com"
  }
}
