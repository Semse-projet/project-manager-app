# Runtime
PORT=8080
ENVIRONMENT=production

# Required in production. Configure the same value only on apps/api and this
# service; never expose it to apps/web or a NEXT_PUBLIC_* variable.
VISION_SERVICE_API_KEY=replace-with-a-dedicated-vision-shared-secret

# This service is server-to-server. Leave CORS empty unless a reviewed browser
# origin genuinely needs access; "*" is ignored.
VISION_CORS_ALLOWED_ORIGINS=

# Extra exact public hosts for image downloads. Built-in provider suffixes cover
# Railway public domains, S3, Supabase, Cloudinary, B2, R2, Azure, GCS and DO.
# Listing a host never permits a private, loopback or link-local resolved IP.
VISION_ALLOWED_HOSTS=api.semseproject.com

# Download/decode budgets.
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=40000000
VISION_IMAGE_TIMEOUT_SECONDS=15
VISION_MAX_IMAGE_REDIRECTS=3

# Local tests/dev may use mock:// and localhost automatically. Production
# disables them regardless of this value.
VISION_ALLOW_MOCK_URLS=false
